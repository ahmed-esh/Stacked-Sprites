# Configure these in your hosting provider. Node does not load this file automatically.
NODE_ENV=production
PUBLIC_ORIGIN=https://sprites.example.com
PORT=5173
# Only set this after verifying your ingress chain and blocking direct Node access.
TRUST_PROXY_HOPS=0
ALLOW_CUSTOM_ENDPOINTS=false
API_REQUESTS_PER_MINUTE=30
MAX_ACTIVE_REQUESTS=8
MAX_ACTIVE_PER_CLIENT=2
